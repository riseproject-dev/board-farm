FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    python3 \
    python3-pip \
    python3-venv \
    sudo \
    iputils-ping \
    ca-certificates \
    jq \
    libicu-dev \
    libkrb5-3 \
    zlib1g \
    opensbi \
    u-boot-qemu \
    qemu-system-misc \
    psmisc \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment to isolate labgrid and pytest entrypoints
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install labgrid and pytest inside virtualenv
RUN pip install --no-cache-dir labgrid pytest

WORKDIR /runner

# Download official GitHub Actions runner package
RUN RUNNER_VERSION=2.317.0 && \
    curl -o actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz -L https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz && \
    tar xzf ./actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz && \
    rm actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz

COPY entrypoint.sh /runner/entrypoint.sh
RUN chmod +x /runner/entrypoint.sh

ENTRYPOINT ["/runner/entrypoint.sh"]
