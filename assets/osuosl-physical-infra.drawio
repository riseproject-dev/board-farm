        <mxCell id="dut_fleet" value="&lt;b&gt;10x 3U Board Shelves — 100x Alibaba Zhihe A210 (+ ~10–12 SpacemiT K3 Planned)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;'&gt;[Physical Hands-On Care: OSUOSL • All Firmware, Bootloader, Kernel &amp;amp; OS: 100% RISE-Controlled]&lt;/span&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2.5;fontColor=#1B5E20;fontFamily=Helvetica;startSize=44;align=center;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="550" y="700" width="620" height="255" as="geometry"/>
        </mxCell>
        <mxCell id="dut_yocto" value="&lt;b&gt;Yocto CI Pool&lt;/b&gt;&lt;hr/&gt;• &lt;code&gt;meta-riscv&lt;/code&gt;&lt;br/&gt;• Nightly &amp;amp; PR boot&lt;br/&gt;• TFTP / RAM rootfs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.8;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#1B5E20;fontSize=10.5;fontFamily=Helvetica;" vertex="1" parent="dut_fleet">
          <mxGeometry x="18" y="58" width="140" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="dut_aosp" value="&lt;b&gt;AOSP CI Pool&lt;/b&gt;&lt;hr/&gt;• RP024 Android&lt;br/&gt;• Fastboot flash&lt;br/&gt;• USB ADB testing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.8;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#1B5E20;fontSize=10.5;fontFamily=Helvetica;" vertex="1" parent="dut_fleet">
          <mxGeometry x="168" y="58" width="140" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="dut_kernel" value="&lt;b&gt;Kernel &amp;amp; Userspace&lt;/b&gt;&lt;hr/&gt;• Mainline / RVCK&lt;br/&gt;• GCC / LLVM / RVV&lt;br/&gt;• &lt;code&gt;riscv-runner&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.8;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#1B5E20;fontSize=10.5;fontFamily=Helvetica;" vertex="1" parent="dut_fleet">
          <mxGeometry x="318" y="58" width="140" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="dut_dev" value="&lt;b&gt;Developer Pool&lt;/b&gt;&lt;hr/&gt;• Public IPv4 SSH&lt;br/&gt;• Or via Jumpbox&lt;br/&gt;• Bring-up &amp;amp; debug" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;strokeWidth=1.8;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontColor=#01579B;fontSize=10.5;fontFamily=Helvetica;" vertex="1" parent="dut_fleet">
          <mxGeometry x="468" y="58" width="134" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="dut_footer" value="&lt;b&gt;Per-Board Interfaces:&lt;/b&gt; 1 GbE RJ45 (DHCP/TFTP/Fastboot-UDP/SSH) • FTDI UART Console (&lt;code&gt;115200 8N1&lt;/code&gt;) • USB 2.0 OTG (Fastboot/ADB) • Switched 12V Barrel&lt;br/&gt;&lt;b&gt;OS Handover:&lt;/b&gt; OSUOSL flashes RISE's baseline image at initial shelf bring-up; post-handover software &amp;amp; firmware are 100% RISE-owned." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#81C784;strokeWidth=1.2;fontColor=#1B5E20;fontSize=10;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="dut_fleet">
          <mxGeometry x="18" y="188" width="584" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="gha_host" value="&lt;b&gt;1x GitHub Actions Runner Host (x86, 16+ Cores, 64GB+ RAM, NVMe)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;'&gt;[100% RISE-Controlled — Co-located at OSUOSL on Both Farm VLANs]&lt;/span&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2.5;fontColor=#1B5E20;fontFamily=Helvetica;startSize=44;align=center;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1230" y="280" width="490" height="675" as="geometry"/>
        </mxCell>
        <mxCell id="gha_desc" value="&lt;b&gt;Full RISE Operational Control:&lt;/b&gt; Root access, OS updates, Docker/Podman ephemeral runner containers, secrets &amp;amp; workflow concurrency. Isolated from OSU jumpbox." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1.4;fontColor=#1B5E20;fontSize=10.5;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="gha_host">
          <mxGeometry x="20" y="56" width="450" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="gha_yocto" value="&lt;b&gt;Containerized GHA Runner Pool — Yocto (&lt;code&gt;meta-riscv&lt;/code&gt;)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#F1F8E9;strokeColor=#2E7D32;strokeWidth=2;fontColor=#1B5E20;fontFamily=Helvetica;startSize=28;align=left;spacingLeft=12;collapsible=0;fontSize=11.5;" vertex="1" parent="gha_host">
