        <mxCell id="dut_bg1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCEDC8;strokeColor=#2E7D32;strokeWidth=1.5;opacity=75;" vertex="1" parent="1">
          <mxGeometry x="558" y="708" width="620" height="245" as="geometry"/>
